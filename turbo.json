{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["APP_ENV", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "APP_URL",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "EVENT_DISPATCH",
        "INNGEST_*",
        "NEXT_PUBLIC_*",
        "SENTRY_*"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "test:integration": {
      "cache": false,
      "env": ["APP_DB_PASSWORD", "DATABASE_ADMIN_URL", "DATABASE_URL", "LOG_LEVEL", "STORAGE_DIR"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
