# ── Ambiente ───────────────────────────────────────────────
APP_ENV=local                 # local | preview | staging | production
LOG_LEVEL=debug               # trace | debug | info | warn | error
APP_URL=http://localhost:3000

# ── Banco (Neon em nuvem, Docker localmente) ─────────────────
# Papel da aplicação: NÃO é dono das tabelas e NÃO tem BYPASSRLS. RLS vale para ele.
DATABASE_URL=postgres://aos_app:aos_app_local@localhost:5432/agency_os
# Papel dono: migrações, seeds e o relay do outbox (lê eventos de todos os workspaces).
DATABASE_ADMIN_URL=postgres://aos_owner:aos_owner@localhost:5432/agency_os
# Senha usada por "pnpm db:roles" para criar/atualizar o papel aos_app.
APP_DB_PASSWORD=aos_app_local

# ── Inngest (filas/jobs) ────────────────────────────────────
# Em desenvolvimento, rode "pnpm dev:jobs" e deixe as chaves vazias.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# ── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=            # só no CI/build, para enviar source maps

# ── Logs (opcional) ─────────────────────────────────────────
AXIOM_TOKEN=
AXIOM_DATASET=

# ── Autenticação e jobs ─────────────────────────────────────
BETTER_AUTH_SECRET=           # obrigatório em produção (32+ caracteres); em dev há um padrão local
EVENT_DISPATCH=local          # local = outbox despachado no próprio processo; inngest = relay + Inngest
STORAGE_DIR=                  # dev: pasta dos arquivos (padrão apps/web/.data/storage)
STORAGE_DRIVER=disk           # disk (dev) | db (demo online sem R2)
CRON_SECRET=                  # obrigatório online: a Vercel Cron envia como Bearer
DEMO_PASSWORD=                # senha dos usuários de demonstração no seed (vazio = demo1234)
WHATSAPP_ENABLED=0            # adaptador WhatsApp desligado até a fase F1.5

# ── Próximas fases (ainda não usados) ──────────────────────
R2_ACCOUNT_ID=                # Sprint 3
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RESEND_API_KEY=               # Sprint 6
UPSTASH_REDIS_REST_URL=       # Sprint 1 (rate limit)
UPSTASH_REDIS_REST_TOKEN=
